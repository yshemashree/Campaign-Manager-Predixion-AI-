# Copy to .env to override defaults. Nothing here is required: `docker compose up` works
# without a .env file.

# Runtime
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# Postgres credentials (used by the postgres container and by the app)
POSTGRES_USER=campaign
POSTGRES_PASSWORD=campaign
POSTGRES_DB=campaign_manager

# Where calls go. Defaults to the mock; the real Sarvam API is never used in this project.
SARVAM_BASE_URL=http://mock-sarvam:9000
PUBLIC_BASE_URL=http://api:8000

# Secrets: the defaults are for local use only. Set your own anywhere else.
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
ENCRYPTION_KEY=bG9jYWwtZGV2LWVuY3J5cHRpb24ta2V5LTMyYnl0ZXM=
WEBHOOK_SIGNING_SECRET=local-dev-webhook-secret

# Engine
DISPATCH_SLOTS=32
WEBHOOK_TIMEOUT_S=300
SEED_DEMO_DATA=true

# Mock Sarvam: speed-up factor and fault injection (0 to 1)
MOCK_SPEED=10
MOCK_FAIL_5XX_RATE=0
MOCK_WEBHOOK_DROP_RATE=0
MOCK_WEBHOOK_DUP_RATE=0.05

# Ports published on your machine (change if something else already uses them)
WEB_HOST_PORT=8080
API_HOST_PORT=8000
MOCK_SARVAM_HOST_PORT=9000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
