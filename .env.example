# Copy to .env to override defaults. Nothing here is required: `docker compose up` works
# without a .env file.

# Runtime
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# Postgres credentials (used by the postgres container and by the app)
POSTGRES_USER=campaign
POSTGRES_PASSWORD=campaign
POSTGRES_DB=campaign_manager

# Where calls go. Defaults to the mock; the real Sarvam API is never used in this project.
SARVAM_BASE_URL=http://mock-sarvam:9000

# Ports published on your machine (change if something else already uses them)
WEB_HOST_PORT=8080
API_HOST_PORT=8000
MOCK_SARVAM_HOST_PORT=9000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
