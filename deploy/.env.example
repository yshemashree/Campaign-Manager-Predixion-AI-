# Copy to deploy/.env on the server. `deploy/setup.sh` does this for you and fills in random secrets.

# The public address. With no domain, use your server's IP through sslip.io,
# e.g. 129-146-12-34.sslip.io for IP 129.146.12.34. Caddy gets the certificate itself.
SITE_ADDRESS=

POSTGRES_PASSWORD=
JWT_SECRET=
# 32 random bytes, base64
ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=

# The first superadmin, created on the first start
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# Calls last a tenth of real time in the mock, so a demo campaign finishes in minutes
MOCK_SPEED=10
